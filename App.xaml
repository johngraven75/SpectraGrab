<Application x:Class="SpectraGrab.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#CC151827" />
        <SolidColorBrush x:Key="PanelSoftBrush" Color="#991E2335" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF7FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B9C3D1" />
        <SolidColorBrush x:Key="AccentBrush" Color="#21D4FD" />
        <SolidColorBrush x:Key="HotAccentBrush" Color="#FF7A59" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF7FA" />
            <Setter Property="Background" Value="#2D3350" />
            <Setter Property="BorderBrush" Value="#3D466C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFF7FA" />
            <Setter Property="Background" Value="#26304A" />
            <Setter Property="BorderBrush" Value="#52607F" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="#21D4FD" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#FFF7FA" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Application.Resources>
</Application>
